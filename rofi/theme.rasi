@import "catppuccin-mocha"

* {
  background-color: transparent;
}

window {
    background-color: @mantle;
    border: 2px;
    border-color: @mauve;
}

inputbar {
    color: @text;
    padding: 12px;
}

entry, prompt {
    text-color: inherit;
}

prompt {
    margin: 0px 12px;
}

listview {
    padding: 12px;
    lines: 8;
    columns: 2;
}

element {
    padding: 12px;
    color: @text;
}

element selected.normal {
    text-color: @yellow;
}

element-text, element-icon {
    text-color: inherit;
}

element-icon {
    padding: 0px 12px 0px 0px;
    size: 36px;
}
